<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- LOGO Y NOMBRE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Reserva365"
            android:textColor="#7055B5"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- TITULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="25dp"
            android:text="Iniciar sesión"
            android:textColor="#222222"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- USUARIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usuario"
            android:textColor="#333333"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_field"
            android:hint="Ingresa tu usuario"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- CONTRASEÑA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Contraseña"
            android:textColor="#333333"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_field"
            android:hint="Ingresa tu contraseña"
            android:inputType="textPassword"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- BOTON INICIAR SESION -->
        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#7055B5"
            android:text="Iniciar sesión"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- TEXTO CONTINUAR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="O continúa con"
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- ICONOS FACEBOOK Y GOOGLE -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFacebook"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginEnd="25dp"
                android:background="@drawable/bg_social_icon"
                android:gravity="center"
                android:text="f"
                android:textColor="#1877F2"
                android:textSize="38sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnGoogle"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="@drawable/bg_social_icon"
                android:gravity="center"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="30sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- REGISTRO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="¿No tienes una cuenta?"
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:padding="8dp"
            android:text="Regístrate"
            android:textColor="#7055B5"
            android:textSize="17sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
