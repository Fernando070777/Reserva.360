<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- FOTO DE PERFIL / AVATAR CON X DE WIREFRAME -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_circle_icon">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✕"
                android:textColor="#7055B5"
                android:textSize="48sp" />
        </FrameLayout>

        <!-- NOMBRE Y CORREO DEL USUARIO -->
        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ana López"
            android:textColor="#222222"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmailUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ana.lopez@email.com"
            android:textColor="#666666"
            android:textSize="15sp" />

        <!-- ACCIONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnEditarPerfil"
                style="?attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_button_outline"
                android:text="Editar"
                android:textColor="#7055B5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnModoDueno"
                style="?attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:text="Dashboard Dueño"
                android:textColor="#7055B5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCerrarSesion"
                style="?attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:text="Cerrar sesión"
                android:textColor="#D16B91"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nInicio"
            android:textColor="#92909D"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navExplorar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕\nExplorar"
            android:textColor="#92909D"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/navReservas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣\nReservas"
            android:textColor="#92909D"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nPerfil"
            android:textColor="#7055B5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
