<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ENCABEZADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="HOLA, BIENVENIDO"
                        android:textColor="#92909D"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Reserva365"
                        android:textColor="#29243D"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnNotificaciones"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_social_icon"
                    android:gravity="center"
                    android:text="♧"
                    android:textColor="#7055B5"
                    android:textSize="25sp" />

            </LinearLayout>

            <!-- TEXTO PRINCIPAL -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:lineSpacingExtra="3dp"
                android:text="¿Qué necesitas\nreservar hoy?"
                android:textColor="#29243D"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Encuentra los mejores servicios cerca de ti."
                android:textColor="#92909D"
                android:textSize="14sp" />

            <!-- BUSCADOR -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="22dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="15dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#7055B5"
                    android:textSize="27sp" />

                <EditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Buscar negocios o servicios..."
                    android:singleLine="true"
                    android:textColor="#29243D"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- CATEGORIAS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Categorías"
                    android:textColor="#29243D"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver todas"
                    android:textColor="#7055B5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- GRID DE CATEGORIAS -->

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:columnCount="4"
                android:useDefaultMargins="false">

                <LinearLayout
                    android:id="@+id/catMedicos"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="#EAE4FA"
                        android:gravity="center"
                        android:text="✚"
                        android:textColor="#7055B5"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Médicos"
                        android:textColor="#454153"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/catBarberias"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="#FCE6EE"
                        android:gravity="center"
                        android:text="✂"
                        android:textColor="#D16B91"
                        android:textSize="27sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Barberías"
                        android:textColor="#454153"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/catRestaurantes"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="#FFF0DE"
                        android:gravity="center"
                        android:text="♨"
                        android:textColor="#D99543"
                        android:textSize="27sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Comida"
                        android:textColor="#454153"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/catBelleza"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="#DFF3EC"
                        android:gravity="center"
                        android:text="♡"
                        android:textColor="#42977A"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Belleza"
                        android:textColor="#454153"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </GridLayout>

            <!-- NEGOCIOS DESTACADOS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Negocios destacados"
                android:textColor="#29243D"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Los lugares favoritos de nuestros usuarios"
                android:textColor="#92909D"
                android:textSize="13sp" />

            <!-- TARJETA 1 -->

            <LinearLayout
                android:id="@+id/negocio1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="BARBERÍA"
                    android:textColor="#7055B5"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Barbería Elegance"
                    android:textColor="#29243D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Cortes de cabello y arreglo de barba"
                    android:textColor="#92909D"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="⭐ 4.8     📍 Cerca de ti"
                    android:textColor="#7055B5"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- TARJETA 2 -->

            <LinearLayout
                android:id="@+id/negocio2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="15dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SALUD"
                    android:textColor="#42977A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Clínica Salud"
                    android:textColor="#29243D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Consultas médicas generales"
                    android:textColor="#92909D"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="⭐ 4.9     📍 Cerca de ti"
                    android:textColor="#7055B5"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- NAVEGACION INFERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nInicio"
            android:textColor="#7055B5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navExplorar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕\nExplorar"
            android:textColor="#92909D"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/navReservas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣\nReservas"
            android:textColor="#92909D"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nPerfil"
            android:textColor="#92909D"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>

